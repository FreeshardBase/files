# Copy to .env and fill in. Startup fails with a list of problems if a required value is missing or invalid.
# Generate secrets with: openssl rand -base64 48

# --- required ---
# Origin the browser uses (https; http only for localhost). No path.
FILES_PUBLIC_URL=https://files.example.com
# The shard's OIDC provider and this app's client there.
FILES_OIDC_ISSUER=https://shard.example.com
FILES_OIDC_CLIENT_ID=
FILES_OIDC_CLIENT_SECRET=
# At least 32 characters each. Changing FILES_ENCRYPTION_KEY breaks every connected cloud account.
FILES_SESSION_SECRET=
FILES_ENCRYPTION_KEY=
# Set by the image to /data; only needed outside the container.
# FILES_DATA_DIR=./data

# --- admin role (set both or neither; without them nobody is admin, see freeshard#251) ---
# FILES_OIDC_ROLE_CLAIM=
# FILES_OIDC_ADMIN_VALUE=

# --- cloud providers (each pair optional; without it the provider is not offered) ---
# Redirect URI to register at each provider: <FILES_PUBLIC_URL>/api/v1/connections/callback
# FILES_GOOGLE_CLIENT_ID=
# FILES_GOOGLE_CLIENT_SECRET=
# FILES_DROPBOX_CLIENT_ID=
# FILES_DROPBOX_CLIENT_SECRET=
# FILES_GRAPH_CLIENT_ID=
# FILES_GRAPH_CLIENT_SECRET=
# FILES_GRAPH_TENANT=common

# --- limits (defaults shown) ---
# FILES_MAX_UPLOAD_BYTES=10737418240
# FILES_TRASH_RETENTION_DAYS=30
# FILES_THUMB_CACHE_BYTES=536870912
# FILES_THUMB_TIMEOUT_MS=30000
# FILES_VERSIONS_MAX_COUNT=10
# FILES_VERSIONS_MAX_BYTES=1073741824
# FILES_PORT=3005
# FILES_LOG_LEVEL=info
