{
  "name": "freeshard-files",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:live": "pnpm --filter @files/server test:live",
    "test:litmus": "pnpm --filter @files/server test:litmus",
    "build": "pnpm --filter @files/web build && pnpm --filter @files/server build",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "dev": "pnpm --filter @files/server dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1",
    "yauzl": "^3.4.0"
  },
  "packageManager": "pnpm@12.11.2"
}
